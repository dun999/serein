(serein_app) {
  encode zstd gzip

  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains"
    X-Content-Type-Options "nosniff"
    Referrer-Policy "strict-origin-when-cross-origin"
    Permissions-Policy "publickey-credentials-create=(self), publickey-credentials-get=(self)"
  }

  reverse_proxy 127.0.0.1:3000
}

serein.finance {
  import serein_app
}

www.serein.finance {
  redir https://serein.finance{uri} permanent
}

# Keep the IP-derived hostname as a recovery URL during DNS changes.
serein.103-150-93-190.sslip.io {
  import serein_app
}

# Branded entry point for the handbook. GitBook hosts the content but answers
# 403 to any Host it has not been told about, so this cannot be a transparent
# proxy. Making docs.serein.finance serve GitBook directly means registering it
# as a custom domain in GitBook and repointing this record at them; until then
# the redirect keeps one stable address to publish and link.
docs.serein.finance {
  redir https://disburse.gitbook.io/serein{uri} permanent
}

# Stable public FCC ingress. The sslip.io hostname resolves deterministically
# to the VPS and avoids registering a rotating quick-tunnel URL on-chain.
fcc.103-150-93-190.sslip.io {
  encode zstd gzip

  # The app polls this host from the browser, so it is always a cross-origin
  # read from serein.finance. Results here are public, signed, read-only FCC
  # records carrying no cookies or credentials, and anyone must be able to
  # replay them to verify an authorization independently, so any origin may
  # read them. Without this the browser discards every response and each
  # authorization appears to time out after the instruction fee is spent.
  header {
    Access-Control-Allow-Origin "*"
    Access-Control-Allow-Methods "GET, HEAD, OPTIONS"
    Access-Control-Allow-Headers "Content-Type"
    Access-Control-Max-Age "86400"
  }

  @preflight method OPTIONS
  respond @preflight 204

  reverse_proxy 127.0.0.1:6674
}
