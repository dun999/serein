# Covenant Private Vault — Flare Coston2
# Copy this file to .env.local for the web app. Copy the FCC subset to
# extension/.env when running the confidential extension stack.

# Current protocol coordinates. Re-resolve these from Flare's registries before
# a real deployment; the deploy script intentionally has no silent defaults.
COSTON2_RPC_URL=https://coston2-api.flare.network/ext/C/rpc
FXRP_ADDRESS=
FTSO_V2_ADDRESS=
ASSET_MANAGER_FXRP_ADDRESS=
TEE_MACHINE_REGISTRY_ADDRESS=
# Decimal or 0x bytes32 value written as EXTENSION_ID by extension/pre-build.
# The vault uses it to reject Production TEEs belonging to any other FCC app.
FCC_EXTENSION_ID=

# The same public protocol coordinates exposed to the browser at build time.
NEXT_PUBLIC_FXRP_ADDRESS=
NEXT_PUBLIC_FTSO_V2_ADDRESS=
NEXT_PUBLIC_ASSET_MANAGER_ADDRESS=
NEXT_PUBLIC_TEE_MACHINE_REGISTRY_ADDRESS=
NEXT_PUBLIC_FCC_EXTENSION_ID=

# Deployment only. Never expose this as NEXT_PUBLIC_* or commit a real value.
COSTON2_PRIVATE_KEY=

# Output of `forge script contracts/script/DeployPrivateVault.s.sol`.
NEXT_PUBLIC_VAULT_FACTORY_ADDRESS=

# Output of extension/scripts/pre-build.sh and post-build.sh.
NEXT_PUBLIC_INSTRUCTION_SENDER_ADDRESS=
NEXT_PUBLIC_FCC_TEE_ADDRESS=
NEXT_PUBLIC_FCC_PROXY_URL=http://127.0.0.1:6674

# Server-only Xaman API credentials for the direct-mint signing handoff.
XAMAN_API_KEY=
XAMAN_API_SECRET=

# Release evidence consumed by `pnpm deployment:update` after live verification.
FCC_IMAGE_DIGEST=sha256:01efca7eb60cba645d7b6d2ce80fce3338b31933dac4d9ec1da3321433d2ba30
PUBLIC_WEB_URL=
DEMO_VIDEO_URL=

# FCC runtime. Both authorization signing and policy decryption use tee-node's
# registered machine key through loopback-only endpoints; no operator-supplied
# application decryption key exists.
TEE_SIGN_URL=http://127.0.0.1:7701/sign

# FCC deployment stack (extension/.env).
LANGUAGE=go
CHAIN=coston2
CHAIN_ID=114
CHAIN_URL=https://coston2-api.flare.network/ext/C/rpc
ADDRESSES_FILE=./config/coston2/deployed-addresses.json
LOCAL_MODE=false
SIMULATED_TEE=true
INITIAL_OWNER=
DEPLOYMENT_PRIVATE_KEY=
PROXY_PRIVATE_KEY=
NORMAL_PROXY_URL=https://tee-proxy-coston2-1.flare.rocks
EXT_PROXY_URL=
FCC_INDEXER_DB_HOST=
FCC_INDEXER_DB_NAME=indexer
FCC_INDEXER_DB_USERNAME=
FCC_INDEXER_DB_PASSWORD=
